{
	"schemaVersion": 1,
	"id": "agricraft",
	"version": "${version}",
	"name": "AgriCraft",
	"description": "Agricultural farming extended",
	"authors": [
		"InfinityRaider",
		"Ketheroth",
		"coredex-source"
	],
	"contact": {
		"website": "https://www.curseforge.com/minecraft/mc-mods/agricraft-rereloaded",
		"repo": "https://github.com/Vivoxti/AgriCraft-ReReloaded",
		"issues": "https://github.com/Vivoxti/AgriCraft-ReReloaded/issues"
	},
	"license": "MIT",
	"icon": "logo.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.agricraft.agricraft.fabric.AgriCraftFabric"
		],
		"client": [
			"com.agricraft.agricraft.client.AgriCraftFabricClient"
		],
		"emi": [
			"com.agricraft.agricraft.compat.emi.AgriCraftEmiPlugin"
		],
		"modmenu": [
			"com.agricraft.agricraft.common.config.fabric.ModMenuConfig"
		],
		"jei_mod_plugin": [
			"com.agricraft.agricraft.compat.jei.AgriCraftJeiPlugin"
		],
		"jade": [
			"com.agricraft.agricraft.compat.jade.AgriCraftJadePlugin"
		]
	},
	"mixins": [
		"agricraft-common.mixins.json",
		"agricraft-fabric.mixins.json"
	],
	"depends": {
		"minecraft": ">=1.21",
		"resourcefulconfig": ">=2.1.2"
	},
	"accessWidener": "agricraft-fabric.accesswidener"
}
